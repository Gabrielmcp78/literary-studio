# Copy this file to backend/.env and enter the key locally.
# backend/.env is ignored by Git and must never be committed.

GEMINI_API_KEY=
OPENROUTER_API_KEY=
LITERARY_STUDIO_OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional provider overrides:
LITERARY_STUDIO_OLLAMA_MODEL=gemma4:31b-cloud
LITERARY_STUDIO_OLLAMA_NUM_CTX=262144
# LITERARY_STUDIO_AGY_MODEL=claude-opus-5-5-high
